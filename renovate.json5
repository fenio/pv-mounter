{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':enablePreCommit',
  ],
  ignorePaths: [
    'examples/**',
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^\\.github/workflows/.+\\.ya?ml$/',
      ],
      matchStrings: [
        'go-version:\\s*[\'"]?(?<currentValue>\\d+\\.\\d+\\.\\d+)[\'"]?',
      ],
      datasourceTemplate: 'golang-version',
      depNameTemplate: 'golang',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^Makefile$/',
      ],
      matchStrings: [
        'go get (?<depName>k8s\\.io/[^@]+)@(?<currentValue>.+?)\\s',
      ],
      datasourceTemplate: 'go',
    },
  ],
}
